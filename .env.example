# ===================================================
# ARENA FDP — Variáveis de Ambiente
# ===================================================

# Supabase (Configuração pública do projeto)
NEXT_PUBLIC_SUPABASE_URL=https://sua-instancia.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Supabase (Service Role — NUNCA expor no cliente)
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-secreta-aqui

# Segredo para assinatura de JWTs de sala e perfil (HS256)
# Gerar com: openssl rand -base64 32
ROOM_TOKEN_SECRET=gerar-um-segredo-aleatorio-forte-de-no-minimo-32-caracteres
